<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/kalikayen_navy</item>
        <item name="colorPrimaryDark">@color/kalikayen_navy</item>
        <item name="colorAccent">@color/kalikayen_blue</item>
        <item name="android:windowBackground">@color/kalikayen_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/kalikayen_navy</item>
        <item name="android:navigationBarColor">@color/kalikayen_navy</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/kalikayen_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/kalikayen_navy</item>
        <item name="android:navigationBarColor">@color/kalikayen_navy</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@color/kalikayen_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/kalikayen_navy</item>
        <item name="android:navigationBarColor">@color/kalikayen_navy</item>
    </style>
</resources>
