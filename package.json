{
  "name": "inventaris-air-desa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AIRLOG - Sistem Inventarisasi dan Pelaporan Kondisi Sarana Air Bersih Berbasis Geotagging Partisipatif Desa Kalikayen (Klaster K4)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "mobile:setup": "npm install @capacitor/core @capacitor/cli @capacitor/android && npm run build && npx cap add android",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@supabase/supabase-js": "^2.48.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
